# Database
DATABASE_URL=sqlite:///./data/database.sqlite

# Seller info (receipts)
SELLER_NAME=
SELLER_ADDRESS=
SELLER_NIP=

# App config
QUARTERLY_LIMIT=10813.50
RECEIPT_PREFIX=R
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend config (uvicorn)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend dev: allow Next.js dev resources from any LAN/browser origin.
# Leave empty/false for stricter dev builds.
NEXT_DEV_ALLOW_ALL_ORIGINS=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
